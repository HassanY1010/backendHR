model HiringPlan {
  id             String       @id @default(uuid())
  companyId      String
  year           Int          @default(2027)
  departmentId   String
  position       String
  quantity       Int          @default(1)
  fulfilledCount Int          @default(0)
  expectedDate   DateTime
  budget         Float        @default(0)
  status         String       @default("PLANNED") // PLANNED, IN_PROGRESS, FULFILLED, CANCELLED
  notes          String?      @db.Text
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  company        Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  department     Department   @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  jobRequests    JobRequest[]

  @@index([companyId])
  @@index([departmentId])
  @@index([year])
  @@map("hiringplan")
}

model JobRequest {
  id               String                      @id @default(uuid())
  requestId        String                      @unique
  companyId        String
  createdBy        String
  jobTitle         String
  departmentId     String
  hiringManagerId  String?
  location         String
  employmentType   job_request_employment_type @default(FULL_TIME)
  vacancies        Int                         @default(1)
  
  // Job Details
  jobSummary       String?                     @db.Text
  requiredExperience String?                   @db.Text
  educationLevel   String?
  certifications   String?                     @db.Text
  languages        String?
  responsibilities String?                     @db.Text
  
  // Financial Information
  salaryMin        Float?
  salaryMax        Float?
  budgetCode       String?
  costCenter       String?
  
  // Hiring Info & Hiring Types System
  hiringType       hiring_type                 @default(IMMEDIATE)
  hiringReason     job_request_hiring_reason   @default(NEW_POSITION)
  requiredDate     DateTime?
  hiringDeadline   DateTime?                   // Immediate Hiring Deadline
  hiringPlanId     String?                     // Manpower Force Plan Link
  freezeReason     freeze_reason?              // On Hold Reason
  frozenDate       DateTime?                   // Date Request Frozen
  resumeDate       DateTime?                   // Expected Date To Resume
  ownerId          String?                     // Owner / Assignee for On Hold Request
  ownerName        String?
  priority         job_request_priority        @default(MEDIUM)
  status           job_request_status          @default(DRAFT)
  
  createdAt        DateTime                    @default(now())
  updatedAt        DateTime                    @updatedAt
  deletedAt        DateTime?

  // Relations
  company          Company                     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdByUser    User                        @relation("JobRequestCreatedBy", fields: [createdBy], references: [id], onDelete: Cascade)
  hiringManager    User?                       @relation("JobRequestHiringManager", fields: [hiringManagerId], references: [id], onDelete: SetNull)
  department       Department                  @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  hiringPlan       HiringPlan?                 @relation(fields: [hiringPlanId], references: [id], onDelete: SetNull)
  skills             JobRequestSkill[]
  history            JobRequestHistory[]
  approvals          ApprovalRequest[]
  onHoldLogs         OnHoldLog[]
  workflowInstance   WorkflowInstance?
  candidateApplications CandidateApplication[]
  aiJobDescriptions    AIJobDescription[]


  @@index([companyId])
  @@index([departmentId])
  @@index([createdBy])
  @@index([status])
  @@index([priority])
  @@index([hiringType])
  @@map("jobrequest")
}

model OnHoldLog {
  id           String         @id @default(uuid())
  jobRequestId String
  freezeReason freeze_reason
  frozenDate   DateTime       @default(now())
  resumeDate   DateTime?
  action       String         @default("FREEZE") // FREEZE, UNFREEZE
  performedBy  String
  performerName String?
  comment      String?        @db.Text
  createdAt    DateTime       @default(now())

  jobRequest   JobRequest     @relation(fields: [jobRequestId], references: [id], onDelete: Cascade)

  @@index([jobRequestId])
  @@map("onholdlog")
}

model JobRequestSkill {
  id           String     @id @default(uuid())
  jobRequestId String
  skillName    String
  jobRequest   JobRequest @relation(fields: [jobRequestId], references: [id], onDelete: Cascade)

  @@index([jobRequestId])
  @@map("jobrequestskill")
}

model AIJobDescription {
  id               String      @id @default(uuid())
  companyId        String
  jobRequestId     String?
  jobTitle         String
  generatedContent Json
  marketAnalysis   Json?
  version          Int         @default(1)
  createdBy        String
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  company          Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdByUser    User        @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  jobRequest       JobRequest? @relation(fields: [jobRequestId], references: [id], onDelete: SetNull)

  @@unique([companyId, jobTitle, version], map: "aijobdescription_companyId_jobTitle_version_key")
  @@index([companyId])
  @@index([jobRequestId])
  @@index([createdBy])
  @@map("aijobdescription")
}



model JobRequestHistory {
  id           String             @id @default(uuid())
  jobRequestId String
  action       String
  oldStatus    job_request_status?
  newStatus    job_request_status?
  performedBy  String
  comment      String?            @db.Text
  createdAt    DateTime           @default(now())

  jobRequest   JobRequest         @relation(fields: [jobRequestId], references: [id], onDelete: Cascade)
  performer    User               @relation(fields: [performedBy], references: [id], onDelete: Cascade)

  @@index([jobRequestId])
  @@index([performedBy])
  @@map("jobrequesthistory")
}

model ApprovalRequest {
  id           String          @id @default(uuid())
  jobRequestId String
  approverId   String?
  approvalType approval_type
  stepOrder    Int             @default(1)
  status       approval_status @default(PENDING)
  comment      String?         @db.Text
  approvedAt   DateTime?
  createdAt    DateTime        @default(now())

  jobRequest   JobRequest      @relation(fields: [jobRequestId], references: [id], onDelete: Cascade)
  approver     User?           @relation(fields: [approverId], references: [id], onDelete: SetNull)

  @@index([jobRequestId])
  @@index([approverId])
  @@map("approvalrequest")
}

